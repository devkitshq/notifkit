{
  "name": "notifkit",
  "version": "0.1.3",
  "description": "Self-hosted notification infrastructure. One call delivers to email, SMS, push, and webhook — routed by preference, quiet hours, and consent.",
  "license": "MIT",
  "author": "devkitshq",
  "homepage": "https://notifkit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devkitshq/notifkit.git"
  },
  "bugs": {
    "url": "https://github.com/devkitshq/notifkit/issues"
  },
  "keywords": [
    "notifications",
    "notification-system",
    "email",
    "sms",
    "push-notifications",
    "webhooks",
    "self-hosted",
    "queue",
    "redis-streams",
    "postgres",
    "drizzle",
    "transactional-email",
    "user-preferences",
    "quiet-hours",
    "unsubscribe",
    "multi-tenant",
    "typescript"
  ],
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "drizzle",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "ai": "^7.0.37",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "ioredis": "^5.4.1",
    "pino": "^9.2.0",
    "pino-pretty": "^11.0.0",
    "postgres": "^3.4.4",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "prettier": "^3.3.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.3",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.1"
}
